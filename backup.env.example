# Off-site backup credentials for the `backup` service. Copy to backup.env, chmod 600.
# Never put these in .env, and never put APP_SECRET here.

# Any restic backend works. S3-compatible object storage example (Hetzner, UpCloud, B2, ...):
#   RESTIC_REPOSITORY=s3:https://<endpoint>/<bucket>/kili
# Cloudflare R2 (EU jurisdiction): s3:https://<account-id>.eu.r2.cloudflarestorage.com/<bucket>/kili,
# with an "Object Read & Write" token scoped to the bucket, and AWS_DEFAULT_REGION=auto.
# Use an access key that can only reach this one bucket.
RESTIC_REPOSITORY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto

# Encrypts the backups. At least 32 random characters (openssl rand -base64 48).
# Store it in the password manager: without it the backups can't be restored.
RESTIC_PASSWORD=

# Optional dead-man's switch, e.g. https://hc-ping.com/<uuid> (healthchecks.io).
# Pinged after every successful run, with /fail appended on failure.
BACKUP_PING_URL=

# How often to ship the snapshot (seconds), and how old the bot's snapshot may be before
# the run counts as failed (minutes).
BACKUP_INTERVAL_SECONDS=21600
BACKUP_MAX_SNAPSHOT_AGE_MINUTES=180
