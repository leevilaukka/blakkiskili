{
  "name": "blakkiskili",
  "version": "2.0.0",
  "description": "Telegram bot that estimates blood alcohol concentration. Bun + TypeScript, based on the original Bläkkisvuohi.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "bun check",
    "web:dev": "cd web && bun run dev",
    "web:build": "cd web && bun install && bun run build",
    "web:check": "cd web && bun run check",
    "web:demo": "bun scripts/web-demo.ts"
  },
  "dependencies": {
    "@grammyjs/runner": "^2.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "grammy": "^1.46.0",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
