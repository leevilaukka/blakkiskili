# Telegram bot token from @BotFather
BOT_TOKEN=

# At least 32 random characters, e.g. `openssl rand -base64 48`.
# Used to derive the ID hashing key and the name encryption key.
# BACK IT UP: if it's lost or changed, every stored account becomes unreachable.
APP_SECRET=

# SQLite file. In Docker this lives on the ./data volume.
DB_PATH=./data/kili.sqlite

# Comma-separated Telegram user ids allowed to use /admin_stats
ADMIN_IDS=

# polling (default, no public URL needed) or webhook
BOT_MODE=polling
# Webhook mode only: public HTTPS URL that reaches /telegram on PORT, and a random secret
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=8080

# Accounts unused for INACTIVE_DELETE_DAYS are deleted; the user gets a private warning
# INACTIVE_WARN_DAYS before. Any use of the bot resets the clock. 0 = keep accounts forever.
INACTIVE_DELETE_DAYS=730
INACTIVE_WARN_DAYS=30

# Alko product search (inline mode + menu) uses Alkometriikka's public catalogue.
# Unset = https://alkometriikka.fi/data.json; set to an empty value to disable search.
# ALKOMETRIIKKA_URL=

# Linking one account to several chat platforms (Asetukset → Yhdistetyt palvelut, /yhdista).
# Leave off until another platform (e.g. a Discord bot) shares this database.
ACCOUNT_LINKING=

# Optional, shown in /about and help texts
MAINTAINER=
# Maintainer's Telegram username (with or without @), shown next to the name
MAINTAINER_TELEGRAM=
SOURCE_URL=

# Consistent database snapshots for the off-site backup (set automatically in docker-compose).
# Empty = disabled.
BACKUP_DIR=
BACKUP_EVERY_MINUTES=60

# Production with docker compose: also start the off-site backup service (needs backup.env)
COMPOSE_PROFILES=backup

# Times in messages are shown in this zone
TZ=Europe/Helsinki
